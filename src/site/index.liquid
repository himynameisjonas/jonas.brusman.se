---
layout: layout.liquid
description: Jonas Brusman's blog. Photos and some tech / code stuff.
title: Blog
---
<div class="grid max-w-5xl grid-cols-1 items-start gap-x-8 gap-y-10 md:grid-cols-2">
  <div>
    <a href="/articles/">
      <h2 class="header-block">
        Articles
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="header-icon">
          <path fill-rule="evenodd" d="M5.625 1.5c-1.036 0-1.875.84-1.875 1.875v17.25c0 1.035.84 1.875 1.875 1.875h12.75c1.035 0 1.875-.84 1.875-1.875V12.75A3.75 3.75 0 0 0 16.5 9h-1.875a1.875 1.875 0 0 1-1.875-1.875V5.25A3.75 3.75 0 0 0 9 1.5H5.625ZM7.5 15a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5A.75.75 0 0 1 7.5 15Zm.75 2.25a.75.75 0 0 0 0 1.5H12a.75.75 0 0 0 0-1.5H8.25Z" clip-rule="evenodd" />
          <path d="M12.971 1.816A5.23 5.23 0 0 1 14.25 5.25v1.875c0 .207.168.375.375.375H16.5a5.23 5.23 0 0 1 3.434 1.279 9.768 9.768 0 0 0-6.963-6.963Z" />
        </svg>
      </h2>
    </a>
    <div class="sm:py-5">
      {% assign articles = collections.articles | reverse %}
      {% for post in articles limit: 6 %}
        {% include 'list_article' %}
      {% endfor %}

      <div class="mt-2 mb-2 border-t-4 border-salmon-500 pt-2 text-xl font-semibold dark:border-salmon-600">
        <a href="/articles/" class="block text-center link text-inherit">View all articles</a>
      </div>
    </div>
  </div>

  <div>
    <a href="https://photos.brusman.se">
      <h2 class="header-block">
        Photos
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="header-icon">
          <path d="M12 9a3.75 3.75 0 1 0 0 7.5A3.75 3.75 0 0 0 12 9Z" />
          <path fill-rule="evenodd" d="M9.344 3.071a49.52 49.52 0 0 1 5.312 0c.967.052 1.83.585 2.332 1.39l.821 1.317c.24.383.645.643 1.11.71.386.054.77.113 1.152.177 1.432.239 2.429 1.493 2.429 2.909V18a3 3 0 0 1-3 3h-15a3 3 0 0 1-3-3V9.574c0-1.416.997-2.67 2.429-2.909.382-.064.766-.123 1.151-.178a1.56 1.56 0 0 0 1.11-.71l.822-1.315a2.942 2.942 0 0 1 2.332-1.39ZM6.75 12.75a5.25 5.25 0 1 1 10.5 0 5.25 5.25 0 0 1-10.5 0Zm12-1.5a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd" />
        </svg>
      </h2>
    </a>
    <p class="pt-1 text-neutral-500 dark:text-neutral-400">
      My photos have moved to <a href="https://photos.brusman.se" class="link">photos.brusman.se</a> — here are the latest.
    </p>
    <div class="py-5">
      {% if photostream.journal or photostream.photos.size > 0 %}
        {% if photostream.journal %}
          {% assign j = photostream.journal %}
          <a
            href="{{ j.href }}"
            class="ar-3x2 group mb-3 block bg-neutral-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-salmon-500 dark:bg-neutral-800 dark:focus-visible:outline-salmon-600"
          >
            <img
              src="{{ j.img }}"
              alt="{{ j.alt }}"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover"
            />
            <div class="absolute inset-0 flex flex-col justify-center bg-gray-700/5 px-4 text-center transition-colors group-hover:bg-transparent">
              <h3 class="pb-1 text-3xl/14 text-balance">
                <span class="bg-neutral-100/75 box-decoration-clone px-2 py-1 pt-2 text-neutral-700 transition-colors group-hover:bg-neutral-100/90 dark:bg-neutral-900/75 dark:text-neutral-300 dark:group-hover:bg-neutral-900/85">
                  {{- j.title -}}
                </span>
              </h3>
              {% if j.date %}
                <time datetime="{{ j.date }}" class="pt-1 font-medium text-gray-100">{{ j.date }}</time>
              {% endif %}
            </div>
          </a>
          {% if j.intro %}
            <p class="mb-4 text-neutral-600 dark:text-neutral-400">
              {{ j.intro | truncatewords: 24 }}
              <a href="{{ j.href }}" class="link whitespace-nowrap">Read journal →</a>
            </p>
          {% endif %}
        {% endif %}
        {% if photostream.photos.size > 0 %}
          {% if photostream.journal %}
            <div class="mt-6 mb-3 flex items-center gap-3">
              <h3 class="font-semibold text-neutral-700 dark:text-neutral-300">Latest photos</h3>
              <span class="h-px flex-1 bg-neutral-200 dark:bg-neutral-700"></span>
            </div>
          {% endif %}
          <div class="grid grid-cols-2 gap-2">
            {% for photo in photostream.photos %}
              <a
                href="{{ photo.href }}"
                class="ar-3x2 group block bg-neutral-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-salmon-500 dark:bg-neutral-800 dark:focus-visible:outline-salmon-600"
              >
                <img
                  src="{{ photo.img }}"
                  alt="{{ photo.alt }}"
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                />
                {% if photo.date %}
                  <div class="pointer-events-none absolute inset-x-0 bottom-0 flex justify-end p-2 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100 motion-reduce:transition-none">
                    <time
                      datetime="{{ photo.date }}"
                      class="bg-neutral-100/80 px-1.5 py-0.5 text-xs font-medium text-neutral-700 dark:bg-neutral-900/80 dark:text-neutral-300"
                    >
                      {{ photo.date }}
                    </time>
                  </div>
                {% endif %}
              </a>
            {% endfor %}
          </div>
        {% endif %}
      {% else %}
        <div class="flex flex-col items-center justify-center gap-3 border border-salmon-200 bg-salmon-25 px-6 py-12 text-center text-lg dark:border-salmon-900 dark:bg-neutral-800">
          <p class="text-balance">My photos now live at their own place.</p>
          <a href="https://photos.brusman.se" class="link">Visit photos.brusman.se →</a>
        </div>
      {% endif %}
      <div class="mt-2 mb-2 border-t-4 border-salmon-500 pt-2 text-xl font-semibold dark:border-salmon-600">
        <a href="https://photos.brusman.se" class="block text-center link text-inherit">View all photos</a>
      </div>
    </div>
  </div>
  <div class="text-small flex flex-col justify-center divide-solid divide-salmon-500 py-5 text-center sm:flex-row sm:divide-x md:col-span-2 dark:divide-salmon-600">
    <div class="px-2 py-1 text-balance sm:py-0">Made with ❤️ in Sweden</div>

    <div class="px-2 py-1 sm:py-0">
      <a class="p-2" href="https://xn--sr8hvo.ws/previous">←</a>
      <a class="p-2 sm:p-0" href="https://xn--sr8hvo.ws" title="An IndieWeb Webring">🕸💍</a>
      <a class="p-2" href="https://xn--sr8hvo.ws/next">→</a>
    </div>

    <div class="px-2 py-1 sm:py-0">
      Last updated
      <time class="dt-published" page.datetime="{{page.date | date: "%Y-%m-%d" }}">
        <a href="{{page.url}}" class="u-url">{{ page.date | date: '%Y-%m-%d' }}</a>
      </time>
    </div>
  </div>
</div>

<div class="h-card hidden">
  <a class="p-name u-url" rel="me" href="https://jonas.brusman.se/">Jonas Brusman</a>
  <span class="p-nickname">himynameisjonas</span>
  <p class="p-note">
    I like to do high fives like Finn and Jake, take photographs and build things with Ruby, Rails, JS and Ember.
  </p>
  <img src="https://photo-storage.brusman.se/DSCF0712.jpeg" eleventy:widths="600" class="u-photo" alt="Jonas Brusman">
</div>
